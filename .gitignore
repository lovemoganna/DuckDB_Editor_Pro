# =============================================================================
# DuckDB Manager Pro — .gitignore
# Keep this file committed. It is the shared ignore contract for every clone.
# After changing rules, run: pnpm audit:gitignore
# =============================================================================

# ----- Dependencies -----
node_modules/
.pnpm-store/
.pnp
.pnp.js
.pnp.cjs

# ----- Build / cache / coverage -----
dist/
dist-ssr/
build/
.vite/
.cache/
.turbo/
*.tsbuildinfo
.eslintcache
coverage/
coverage-ts/
*.local

# Vite timestamp configs
vite.config.*.timestamp-*

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Package managers (this repo uses pnpm; keep pnpm-lock.yaml) -----
package-lock.json
yarn.lock
npm-shrinkwrap.json

# ----- Environment / secrets -----
.env
.env.*
!.env.example
!.env.*.example

# ----- Editors / OS -----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ----- Cursor / local agent tooling -----
.cursor/
.cursor/**
.gstack/
.playwright-mcp/
.antigravity/
.gemini/
.claude/
playwright-report/
test-results/
blob-report/

# ----- Local scratch / backups / QA dumps -----
tmp/
backup-*/
output/
_patch_*
*.bak
*.tmp
*.patch
*.diff
verification-*.png
scratch/
artifacts/
test-output.js
interaction-audit.json

# QA / debug screenshots dumped into public/ (keep brand assets)
/public/*.png
/public/import_audit/
/public/lesson_snaps/
/public/switch_test/

# DuckDB WASM is bundled from @duckdb/duckdb-wasm; do not duplicate it in public/.
public/wasm/
public/duckdb-wasm/

# Accidental Vite build output at repo root
/assets/

# ----- DuckDB & SQLite database files -----
*.db
*.duckdb
*.wal
*.sqlite
*.sqlite3

# ----- Certificates / private keys (never commit) -----
*.pem
*.p12
*.pfx
*.key
*.cert
*.crt
